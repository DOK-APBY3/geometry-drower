<Window x:Class="прога_3_сем_1_лаба.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:прога_3_сем_1_лаба"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800">
    <Grid RenderTransformOrigin="0.188,0.34">
        <Canvas x:Name="Scene" HorizontalAlignment="Center" Height="285" VerticalAlignment="Top" Width="680" Margin="0,220,0,0"  Background="#FFB2ADAD"/>
        <Button Content="Произвольный &#xA;треугольник" Margin="60,10,555,440" Click="Button_triangle"/>
        <Button Content="Произвольный &#xA;прямоугольник" Margin="308,10,310,440" Click="Button_rectangle"/>
        <Button Content="Квадрат" Margin="555,10,60,440" Click="Button_square"/>
        <Slider Margin="210,120,150,390" ValueChanged="Slider_Change_X"/>
        <Slider Margin="210,170,150,340" ValueChanged="Slider_Change_Y"/>
        <TextBlock TextWrapping="Wrap" Text="Сдвиг по Y:" Margin="120,170,610,340"/>
        <TextBlock TextWrapping="Wrap" Height="24" Width="70" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,120,0,0"><Run Language="ru-ru" Text="Сдвиг по Х:"/></TextBlock>
    </Grid>
</Window>
